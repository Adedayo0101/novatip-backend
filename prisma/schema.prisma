// schema.prisma
// Novatip backend data model.
// Run `npm run db:generate` after changes.
// Run `npm run db:migrate` to apply locally.

generator client {
  provider = "prisma-client-js"
  // The container runs on Alpine (musl + OpenSSL 3), which is a different
  // target from most dev machines. Without the musl engine listed here the
  // generated client has no engine it can load at runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Creator ───────────────────────────────────────────────────────────────────

model Creator {
  id          String   @id @default(cuid())
  /// Stellar account address (G...)
  walletAddress String @unique
  /// Public slug used in tip URLs, e.g. "alice" for /@alice
  slug        String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  /// Contact address for tip notifications. Optional — a creator who only
  /// wants webhooks is not required to hand one over. Private: excluded from
  /// the select in getCreatorBySlug, which backs both the public creator
  /// endpoint and the resolver.
  email       String?
  /// Whether tip-notification emails are switched on. Defaults to true so
  /// the migration backfills existing creators as "on" — nothing turns off
  /// until a creator turns it off.
  emailEnabled Boolean @default(true)
  /// Whether tip webhooks are dispatched for this creator. Same default,
  /// same reasoning as emailEnabled.
  webhookEnabled Boolean @default(true)
  /// On-chain jar ID registered in tip_splitter, e.g. "@alice"
  jarId       String   @unique
  /// JSON array of Split objects [{ to, bps }]
  splits      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tips        Tip[]
  webhooks    Webhook[]
  notifications Notification[]
  releasedSlugs ReleasedSlug[]

  // No @@index([walletAddress]) or @@index([slug]) here: @unique above
  // already backs each with a unique btree index, so a plain index on the
  // same column would be an exact duplicate — a second write on every
  // sign-in and slug claim for a lookup Postgres already serves off the
  // unique index. See WebhookDelivery's @@index comment for the same
  // reasoning applied there.
}

// ── ReleasedSlug ───────────────────────────────────────────────────────────────
// A slug a creator let go of (by renaming away from it, or by claiming a
// different one) and when. Until the hold window configured by
// CREATOR_SLUG_HOLD_DAYS (default 90 days) expires, the slug stays
// unavailable to everyone except this creator — so the old tip links,
// printed posters and QR codes that still pointing at it can't be handed to
// whoever claims it next, along with the people behind them who meant to
// tip the original creator.

model ReleasedSlug {
  /// The released slug, e.g. "alice" — one row per slug, the latest release
  slug            String   @id
  /// The creator who released it: the only one who may take it while held
  previousOwnerId String
  previousOwner   Creator  @relation(fields: [previousOwnerId], references: [id], onDelete: Cascade)
  /// When it was released; the hold expires CREATOR_SLUG_HOLD_DAYS after this
  releasedAt      DateTime @default(now())

  /// Foreign key back to Creator has no leading column of its own to serve
  /// lookups by (slug above is the primary key), but Postgres does not index
  /// FK columns automatically, and any per-owner query would otherwise scan.
  @@index([previousOwnerId])
}

// ── Tip ───────────────────────────────────────────────────────────────────────

model Tip {
  id          String   @id @default(cuid())
  /// Soroban transaction hash
  txHash      String   @unique
  /// Ledger sequence the TipReceived event was emitted in
  ledger      Int
  /// Ledger close timestamp
  ledgerAt    DateTime
  /// Sender Stellar address
  fromAddress String
  /// Amount in USDC stroops (stored as String to preserve i128 precision)
  amount      String
  /// Optional supporter message (bounded to the contract's 280-byte limit)
  message     String   @default("") @db.VarChar(280)
  /// Whether the creator has hidden this message from public view
  messageHidden Boolean @default(false)
  creatorId   String?
  creator     Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([creatorId])
  @@index([fromAddress])
  @@index([ledger])
  @@index([ledgerAt])
  /// Supports getTopSupporters' GROUP BY "fromAddress" scoped to a creator
  @@index([creatorId, fromAddress])
  /// Supports getTimeSeries' GROUP BY date_trunc("ledgerAt") scoped to a creator
  @@index([creatorId, ledgerAt])
}

// ── Webhook ───────────────────────────────────────────────────────────────────

model Webhook {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id])
  /// Target URL to POST tip events to
  url       String
  /// Shared secret for HMAC signature verification
  secret    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([creatorId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  webhook    Webhook  @relation(fields: [webhookId], references: [id])
  /// HTTP status code returned by the target
  statusCode Int?
  /// Whether delivery succeeded (2xx response)
  success    Boolean  @default(false)
  /// Request payload JSON
  payload    Json
  /// Response body (truncated to 1 KB)
  response   String?
  attemptedAt DateTime @default(now())

  /// Serves the delivery-history endpoint's
  /// `webhookId = ? ORDER BY "attemptedAt" DESC LIMIT n`, which would otherwise
  /// read every row for the webhook and sort it to return twenty. Replaces the
  /// bare @@index([webhookId]) — a webhookId-leading composite serves the same
  /// lookups, and a second index on the fastest-growing table is not free.
  @@index([webhookId, attemptedAt])
  /// Supports the retention prune's `success = ? AND attemptedAt < ?` scan.
  /// Successes and failures age out on different schedules, so success leads
  /// the index and attemptedAt gives the range within each half.
  @@index([success, attemptedAt])
}

// ── Notification ──────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id])
  type      NotificationType
  /// Serialised payload (tip amount, sender, message, etc.)
  payload   Json
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([creatorId])
}

enum NotificationType {
  TIP_RECEIVED
  WEBHOOK_FAILED
}

// ── IndexerCursor ─────────────────────────────────────────────────────────────
// Tracks the last ledger the indexer processed so restarts resume correctly.

model IndexerCursor {
  id          Int    @id @default(1)
  lastLedger  Int    @default(0)
  updatedAt   DateTime @updatedAt
}
