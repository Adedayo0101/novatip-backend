# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://novatip:novatip@localhost:5432/novatip

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Stellar / Soroban ─────────────────────────────────────────────────────────
# testnet | mainnet | local
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed tip_splitter contract ID
TIP_SPLITTER_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC Stellar Asset Contract ID
USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Ledger to start indexing from (set to current ledger on first deploy)
INDEXER_START_LEDGER=0
# Timeout for Soroban RPC calls the indexer makes, e.g. getLatestLedger (ms)
INDEXER_RPC_TIMEOUT_MS=5000
# How often the indexer polls Soroban RPC for new TipReceived events (ms)
INDEXER_POLL_INTERVAL_MS=6000
# Max TipReceived events fetched from Soroban RPC per poll iteration
INDEXER_POLL_LIMIT=200

# ── Rate limits ───────────────────────────────────────────────────────────────
# Server-wide budget for every route not covered by a dedicated limiter below.
# RATE_LIMIT_WINDOW takes @fastify/rate-limit's own format, e.g. "1 minute" or
# a millisecond count.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Per-IP cap on POST /auth/challenge, req/min. Tighter than the shared global
# budget above — that route is unauthenticated, so a single caller could
# otherwise mint nonces for arbitrary wallet addresses.
AUTH_CHALLENGE_RATE_LIMIT=5
# Per-IP cap on the QR endpoints, req/min. QR generation is CPU-heavy and
# public, so the shared global budget is far too permissive here.
QR_RATE_LIMIT=10

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Generate a unique 32-byte key with: openssl rand -hex 32
# Required in production; changing it makes stored webhook secrets unreadable.
WEBHOOK_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Allow private webhook destinations for local development only (default: false).
WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# Most webhooks one creator may register. Every enabled endpoint is delivered
# to on every indexed tip, so this bounds the outbound work one tip can cause.
# Set to 0 to remove the cap.
MAX_WEBHOOKS_PER_CREATOR=5

# Delivery limits. Slow endpoints can be accommodated by raising WEBHOOK_TIMEOUT_MS.
# Response body excerpts are capped by WEBHOOK_MAX_BODY_SIZE (bytes).
# Stored delivery payload records are capped by WEBHOOK_MAX_PAYLOAD_SIZE (bytes).
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_BODY_SIZE=1024
WEBHOOK_MAX_PAYLOAD_SIZE=2048

# ── Webhook delivery retention ────────────────────────────────────────────────
# Delivery rows are pruned on a schedule. Set a window to 0 to keep that class
# forever. Failures are kept longer than successes because they are what gets
# debugged.
WEBHOOK_DELIVERY_RETENTION_DAYS=30
WEBHOOK_DELIVERY_FAILURE_RETENTION_DAYS=90
# Rows deleted per statement, so a large backlog never locks the table
WEBHOOK_DELIVERY_PRUNE_BATCH_SIZE=500
WEBHOOK_DELIVERY_PRUNE_INTERVAL_MINUTES=60

# ── Notifications (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=tips@novatip.xyz

# ── Slugs ─────────────────────────────────────────────────────────────────────
# Days a slug released by renaming or re-claiming stays reserved for its
# previous owner before anyone else may claim it. Previous owners are exempt
# from their own hold. Set to 0 to free a slug the moment it is released.
CREATOR_SLUG_HOLD_DAYS=90

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000

# Comma-separated origins allowed through CORS in production (e.g. preview
# deployments). Default: just APP_BASE_URL. Ignored outside production,
# where any origin is allowed. Commented out below since there is no single
# literal default to uncomment — set it only to add origins beyond APP_BASE_URL.
# CORS_ALLOWED_ORIGINS=https://app.novatip.xyz,https://preview-123.novatip.pages.dev
