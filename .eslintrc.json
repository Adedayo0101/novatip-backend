{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": ["./tsconfig.json", "./tsconfig.scripts.json"],
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "prettier"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended"
  ],
  "rules": {
    "no-console": "error",
    "prettier/prettier": "warn",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/no-explicit-any": "warn",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "ImportDeclaration[source.value=/^\\.{1,2}\\/.*\\.ts$/], ImportExpression[source.value=/^\\.{1,2}\\/.*\\.ts$/], ExportNamedDeclaration[source.value=/^\\.{1,2}\\/.*\\.ts$/], ExportAllDeclaration[source.value=/^\\.{1,2}\\/.*\\.ts$/]",
        "message": "Relative imports must use the .js extension, not .ts — tsc does not rewrite specifiers, so the emitted ESM would fail to resolve at runtime."
      }
    ]
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "overrides": [
    {
      // One-off CLI entry points run with `tsx`, not part of the server —
      // they have no pino logger to write to, so console is the only output.
      "files": ["scripts/**/*.ts", "prisma/seed.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
